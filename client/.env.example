# Where the client sends API calls.
#
# In development leave this relative: Vite proxies /api to VITE_PROXY_TARGET, so the browser
# talks to one origin and the refresh cookie behaves exactly as it will in production.
VITE_API_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:4000

# In production, point it at the deployed API instead and drop VITE_PROXY_TARGET:
# VITE_API_URL=https://campusconnect-api.example.com/api/v1
