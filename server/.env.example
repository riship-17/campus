# ---------------------------------------------------------------------------
# CampusConnect API — copy to .env and fill in.
# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to boot if any required value is missing or too short.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# Database ------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect

# Auth secrets (min 32 chars each; never reuse across environments) ----------
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes-base64url-encoded
TOKEN_PEPPER=replace-me-with-a-different-48-random-bytes-value
QR_SIGNING_SECRET=replace-me-with-a-third-48-random-bytes-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Who may sign up. Comma-separated, no @ ------------------------------------
ALLOWED_EMAIL_DOMAINS=iitb.ac.in

# HTTP ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173
# 'loopback' for local, '1' behind exactly one proxy (Render/Railway/Fly)
TRUST_PROXY=loopback
# Leave unset unless the API and client share a registrable domain
# COOKIE_DOMAIN=.campusconnect.example

# Email — leave SMTP_* unset in development and links are printed to the console
MAIL_FROM=CampusConnect <no-reply@campusconnect.local>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Phase 5: BullMQ + rate-limit store
# REDIS_URL=redis://127.0.0.1:6379
