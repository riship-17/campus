{
  "name": "campusconnect-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"{src,tests}/**/*.js\"",
    "audit:ci": "npm audit --audit-level=high"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "hpp": "0.2.3",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.4",
    "nanoid": "6.0.1",
    "nodemailer": "10.0.12",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "sanitize-html": "2.17.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "10.11.0",
    "globals": "^17.12.0",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "vitest": "5.0.2"
  }
}
